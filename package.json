{
  "name": "rhapsod",
  "version": "2.2.0",
  "description": "A self-hosted music bot for TeamSpeak 3, designed for future TeamSpeak 6 support.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "teamspeak",
    "teamspeak3",
    "music-bot",
    "youtube",
    "soundcloud",
    "spotify",
    "yt-dlp",
    "opus",
    "ffmpeg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Juanzaan/rhapsod.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@honeybbq/teamspeak-client": "^0.2.3",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "libopus-wasm": "^0.2.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
