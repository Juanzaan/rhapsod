RHAPSOD_LOG_LEVEL=info
RHAPSOD_METRICS_INTERVAL_MINUTES=15
RHAPSOD_WATCHDOG_INTERVAL_MINUTES=15
RHAPSOD_MAX_CONCURRENT_COMMANDS=3
# Optional: max concurrent yt-dlp jobs (1-4). Recommended 4 for the 4 vCPU /
# 3 GB OCI profile (I/O-bound, not CPU-bound); unset uses a CPU-adaptive default.
RHAPSOD_MAX_CONCURRENT_YTDLP_JOBS=4
RHAPSOD_MAX_QUEUE_TRACKS=200
RHAPSOD_MAX_TRACKS_PER_USER=30
RHAPSOD_DATA_DIR=./data
RHAPSOD_FFMPEG_PATH=
RHAPSOD_FFMPEG_USER_AGENT=
RHAPSOD_FFPROBE_PATH=
# Optional: comma-separated TeamSpeak uids allowed to use admin commands
RHAPSOD_ADMIN_UIDS=
RHAPSOD_TS3_HOST=127.0.0.1
RHAPSOD_TS3_PORT=9987
RHAPSOD_TS3_NICKNAME=Rhapsod
RHAPSOD_TS3_PASSWORD=
RHAPSOD_TS3_CHANNEL_PASSWORD=
RHAPSOD_TS3_CHANNEL_NAME=
RHAPSOD_TS3_CLIENT_DESCRIPTION=
RHAPSOD_TS3_CONNECT_TIMEOUT_SECONDS=180
RHAPSOD_TS3_AUTO_CONNECT=true
RHAPSOD_YTDLP_PATH=yt-dlp
RHAPSOD_YTDLP_COOKIES_PATH=
# Optional: primary YouTube resolution via youtubei.js (in-process, no yt-dlp
# spawn). When true, yt-dlp is kept as the fallback. Default: false.
RHAPSOD_YOUTUBEI_ENABLED=false
# Optional: YouTube Cookie header value used by youtubei.js for authenticated
# sessions (age-restricted videos). Leave empty to stay anonymous.
RHAPSOD_YOUTUBEI_COOKIE=
# Optional local bgutil POT provider (current upstream default port: 4416).
RHAPSOD_YOUTUBEI_POT_URL=
RHAPSOD_AUDIO_TEST_TONE_SECONDS=0
RHAPSOD_OPUS_BITRATE=96000
RHAPSOD_OPUS_COMPLEXITY=10
RHAPSOD_OPUS_PACKET_LOSS_PERCENT=0
RHAPSOD_LOUDNESS_TARGET_LUFS=-14
# Optional: enables Spotify track links in !play (client credentials flow)
RHAPSOD_SPOTIFY_CLIENT_ID=
RHAPSOD_SPOTIFY_CLIENT_SECRET=
# Optional: user OAuth refresh token for Spotify playlist reads via the Web
# API /items endpoint. Not required: playlists fall back to the public embed
# page. Obtain it by running:
#   node scripts/spotify-auth.mjs
# (add http://127.0.0.1:8888/callback to the app's redirect URIs in the
# Spotify dashboard — "localhost" is no longer accepted)
RHAPSOD_SPOTIFY_REFRESH_TOKEN=
# Optional: verbose mode sends intermediate messages ("Preparando...",
# "Buscando..."). Default: false (minimalist messages only).
RHAPSOD_VERBOSE=false
# Optional: YouTube OAuth 2.0 credentials for youtubei.js authenticated
# sessions. When set, youtubei.js uses OAuth instead of PO tokens.
RHAPSOD_YOUTUBE_CLIENT_ID=
RHAPSOD_YOUTUBE_CLIENT_SECRET=
RHAPSOD_YOUTUBE_REFRESH_TOKEN=
# Optional: Piped API as primary YouTube resolver (disabled by default;
# all public instances are blocked from datacenter IPs).
RHAPSOD_PIPED_ENABLED=false
RHAPSOD_PIPED_INSTANCES=https://pipedapi.kavin.rocks
RHAPSOD_PIPED_TIMEOUT_MS=3000
